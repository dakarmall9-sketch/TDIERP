rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailKey(emailKey) {
      return emailKey is string
        && emailKey.size() >= 5
        && emailKey.size() <= 160
        && emailKey.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z0-9-]{2,}$');
    }

    function isBootstrapAdmin() {
      return isVerified() && request.auth.token.email.lower() == 'dakarmall9@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin()
        || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isStaff() {
      return isBootstrapAdmin()
        || (isVerified() && exists(/databases/$(database)/documents/staff/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isValidRole(role) {
      return role in [
        'admin', 'manager', 'commercial', 'dispatcher', 'driver',
        'accountant', 'warehouse', 'fleet_manager', 'hr', 'client'
      ];
    }

    function isValidCompanySettings(data) {
      return data.keys().hasAll(['id', 'name', 'currency', 'email'])
        && data.keys().hasOnly([
          'id', 'name', 'country', 'currency', 'logoText',
          'address', 'phone', 'email', 'taxNumber', 'defaultTaxRate', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 64
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 160
        && data.currency is string && data.currency.size() >= 3 && data.currency.size() <= 10
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160;
    }

    function isValidShippingConfig(data) {
      return data.keys().hasAll(['customPorts', 'equipmentList'])
        && data.keys().hasOnly(['customPorts', 'equipmentList', 'updatedAt'])
        && data.customPorts is list && data.customPorts.size() <= 200
        && data.equipmentList is list && data.equipmentList.size() <= 100;
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'isActive'])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'permissions',
          'employeeId', 'isActive', 'invitedBy', 'photoUrl', 'createdAt', 'updatedAt', 'lastLoginAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 160
        && isValidRole(data.role)
        && data.isActive is bool
        && (!('permissions' in data) || (data.permissions is list && data.permissions.size() <= 30));
    }

    function isValidInvitation(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'isActive'])
        && data.keys().hasOnly([
          'email', 'displayName', 'role', 'permissions',
          'employeeId', 'isActive', 'invitedBy', 'createdAt', 'updatedAt'
        ])
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 160
        && isValidRole(data.role)
        && data.isActive is bool
        && (!('permissions' in data) || (data.permissions is list && data.permissions.size() <= 30));
    }

    function isValidAppointment(data) {
      return data.keys().hasAll([
          'id', 'code', 'clientName', 'clientEmail', 'clientPhone',
          'originAddress', 'destinationAddress', 'targetDate', 'serviceType', 'status'
        ])
        && data.id is string && data.id.size() <= 128
        && data.code is string && data.code.size() <= 50
        && data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 180
        && data.clientEmail is string && data.clientEmail.size() <= 160
        && data.clientPhone is string && data.clientPhone.size() <= 60
        && data.originAddress is string && data.originAddress.size() <= 300
        && data.destinationAddress is string && data.destinationAddress.size() <= 300
        && data.targetDate is string && data.targetDate.size() <= 30
        && data.serviceType is string && data.serviceType.size() <= 40
        && data.status is string && data.status.size() <= 40
        && (!('originElevator' in data) || data.originElevator is bool)
        && (!('destinationElevator' in data) || data.destinationElevator is bool)
        && (!('originPropertyType' in data) || data.originPropertyType == null || data.originPropertyType in ['appartement', 'maison', 'immeuble'])
        && (!('originFloorLevel' in data) || data.originFloorLevel == null || (data.originFloorLevel is string && data.originFloorLevel.size() <= 30))
        && (!('originFloorLevelOther' in data) || data.originFloorLevelOther == null || (data.originFloorLevelOther is string && data.originFloorLevelOther.size() <= 80))
        && (!('originLevelsCount' in data) || data.originLevelsCount == null || (data.originLevelsCount is string && data.originLevelsCount.size() <= 40))
        && (!('originLevelsCountOther' in data) || data.originLevelsCountOther == null || (data.originLevelsCountOther is string && data.originLevelsCountOther.size() <= 80))
        && (!('destinationPropertyType' in data) || data.destinationPropertyType == null || data.destinationPropertyType in ['appartement', 'maison', 'immeuble'])
        && (!('destinationFloorLevel' in data) || data.destinationFloorLevel == null || (data.destinationFloorLevel is string && data.destinationFloorLevel.size() <= 30))
        && (!('destinationFloorLevelOther' in data) || data.destinationFloorLevelOther == null || (data.destinationFloorLevelOther is string && data.destinationFloorLevelOther.size() <= 80))
        && (!('destinationLevelsCount' in data) || data.destinationLevelsCount == null || (data.destinationLevelsCount is string && data.destinationLevelsCount.size() <= 40))
        && (!('destinationLevelsCountOther' in data) || data.destinationLevelsCountOther == null || (data.destinationLevelsCountOther is string && data.destinationLevelsCountOther.size() <= 80))
        && (!('propertyType' in data) || data.propertyType == null || data.propertyType in ['appartement', 'maison', 'immeuble'])
        && (!('floorLevel' in data) || data.floorLevel == null || (data.floorLevel is string && data.floorLevel.size() <= 30))
        && (!('floorLevelOther' in data) || data.floorLevelOther == null || (data.floorLevelOther is string && data.floorLevelOther.size() <= 80))
        && (!('levelsCount' in data) || data.levelsCount == null || (data.levelsCount is string && data.levelsCount.size() <= 40))
        && (!('levelsCountOther' in data) || data.levelsCountOther == null || (data.levelsCountOther is string && data.levelsCountOther.size() <= 80))
        && (!('serviceTransportMode' in data) || data.serviceTransportMode == null || data.serviceTransportMode in ['aerien', 'maritime', 'terrestre']);
    }

    function isValidVolumeEstimation(data) {
      return data.keys().hasAll(['id', 'clientName', 'totalTransportM3', 'items'])
        && data.id is string && data.id.size() <= 128
        && data.clientName is string && data.clientName.size() <= 180
        && data.totalTransportM3 is number
        && data.items is list && data.items.size() <= 300
        && (!('recommendedVehicles' in data) || (data.recommendedVehicles is string && data.recommendedVehicles.size() <= 160))
        && (!('recommendedVehicleVolumeM3' in data) || data.recommendedVehicleVolumeM3 is number)
        && (!('recommendedMovers' in data) || data.recommendedMovers is number)
        && (!('recommendedWorkDays' in data) || data.recommendedWorkDays is number);
    }

    function isValidQuote(data) {
      return data.keys().hasAll(['id', 'number', 'clientName', 'clientEmail', 'total', 'status', 'currency'])
        && data.id is string && data.id.size() <= 128
        && data.number is string && data.number.size() <= 50
        && data.clientName is string && data.clientName.size() <= 180
        && data.clientEmail is string && data.clientEmail.size() <= 160
        && data.total is number
        && data.status is string && data.status.size() <= 40
        && data.currency is string && data.currency.size() <= 10;
    }

    function isValidChantier(data) {
      return data.keys().hasAll(['id', 'code', 'clientName', 'scheduledDate', 'status'])
        && data.id is string && data.id.size() <= 128
        && data.code is string && data.code.size() <= 50
        && data.clientName is string && data.clientName.size() <= 180
        && data.scheduledDate is string && data.scheduledDate.size() <= 30
        && data.status is string && data.status.size() <= 40;
    }

    function isValidInvoice(data) {
      return data.keys().hasAll(['id', 'number', 'clientName', 'clientEmail', 'totalAmount', 'paidAmount', 'status', 'currency'])
        && data.id is string && data.id.size() <= 128
        && data.number is string && data.number.size() <= 50
        && data.clientName is string && data.clientName.size() <= 180
        && data.clientEmail is string && data.clientEmail.size() <= 160
        && data.totalAmount is number
        && data.paidAmount is number
        && data.status is string && data.status.size() <= 40
        && data.currency is string && data.currency.size() <= 10;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['id', 'date', 'category', 'description', 'amount', 'currency'])
        && data.id is string && data.id.size() <= 128
        && data.date is string && data.date.size() <= 30
        && data.category is string && data.category.size() <= 50
        && data.description is string && data.description.size() <= 300
        && data.amount is number
        && data.currency is string && data.currency.size() <= 10;
    }

    function isValidTransitShipment(data) {
      return data.keys().hasAll(['id', 'reference', 'operationType', 'clientName', 'status'])
        && data.id is string && data.id.size() <= 128
        && data.reference is string && data.reference.size() <= 60
        && data.operationType is string && data.operationType.size() <= 30
        && data.clientName is string && data.clientName.size() <= 180
        && data.status is string && data.status.size() <= 40;
    }

    function isValidShippingLine(data) {
      return data.keys().hasAll(['id', 'name', 'code'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 150
        && data.code is string && data.code.size() <= 30;
    }

    function isValidStockItem(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'quantityInStock'])
        && data.id is string && data.id.size() <= 128
        && data.code is string && data.code.size() <= 40
        && data.name is string && data.name.size() <= 160
        && data.quantityInStock is number;
    }

    function isValidStockMovement(data) {
      return data.keys().hasAll(['id', 'date', 'stockItemId', 'type', 'quantity'])
        && data.id is string && data.id.size() <= 128
        && data.date is string && data.date.size() <= 30
        && data.stockItemId is string && data.stockItemId.size() <= 128
        && data.type is string && data.type.size() <= 40
        && data.quantity is number;
    }

    function isValidVehicle(data) {
      return data.keys().hasAll(['id', 'plateNumber', 'brand', 'model', 'status'])
        && data.id is string && data.id.size() <= 128
        && data.plateNumber is string && data.plateNumber.size() <= 40
        && data.brand is string && data.brand.size() <= 80
        && data.model is string && data.model.size() <= 80
        && data.status is string && data.status.size() <= 40;
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['id', 'firstName', 'lastName', 'email', 'role'])
        && data.id is string && data.id.size() <= 128
        && data.firstName is string && data.firstName.size() <= 100
        && data.lastName is string && data.lastName.size() <= 100
        && data.email is string && data.email.size() <= 160
        && isValidRole(data.role);
    }

    function isValidEmailMessage(data) {
      return data.keys().hasAll(['id', 'folder', 'recipientEmail', 'subject', 'date'])
        && data.id is string && data.id.size() <= 128
        && data.folder is string && data.folder.size() <= 20
        && data.recipientEmail is string && data.recipientEmail.size() <= 160
        && data.subject is string && data.subject.size() <= 250
        && data.date is string && data.date.size() <= 50;
    }

    function isValidAutomationLog(data) {
      return data.keys().hasAll(['id', 'timestamp', 'triggerEvent', 'status'])
        && data.id is string && data.id.size() <= 128
        && data.timestamp is string && data.timestamp.size() <= 50
        && data.triggerEvent is string && data.triggerEvent.size() <= 200
        && data.status is string && data.status.size() <= 20;
    }

    // =========================================================================
    // ROLE MARKER COLLECTIONS (O(1) RBAC Lookup Gates)
    // =========================================================================
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && (
        isAdmin()
        || (
          isOwner(userId)
          && (
            isBootstrapAdmin()
            || (
              exists(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower()))
              && get(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower())).data.isActive == true
              && get(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower())).data.role == 'admin'
            )
          )
        )
      );
      allow update, delete: if isValidId(userId) && isAdmin();
    }

    match /staff/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && (
        isAdmin()
        || (
          isOwner(userId)
          && (
            isBootstrapAdmin()
            || (
              exists(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower()))
              && get(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower())).data.isActive == true
              && get(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower())).data.role != 'client'
            )
          )
        )
      );
      allow update, delete: if isValidId(userId) && isAdmin();
    }

    // =========================================================================
    // INVITATIONS & USER ACCOUNTS
    // =========================================================================
    match /invitations/{emailKey} {
      allow get: if isValidEmailKey(emailKey)
        && (isAdmin() || (isVerified() && emailKey == request.auth.token.email.lower()));
      allow list: if isAdmin();
      allow create, update: if isValidEmailKey(emailKey) && isAdmin() && isValidInvitation(incoming());
      allow delete: if isValidEmailKey(emailKey) && isAdmin();
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isValidUserAccount(incoming()) && (
        isAdmin()
        || (
          isOwner(userId)
          && incoming().uid == request.auth.uid
          && incoming().email.lower() == request.auth.token.email.lower()
          && (
            (isBootstrapAdmin() && incoming().role == 'admin' && incoming().isActive == true)
            || (
              exists(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower()))
              && get(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower())).data.isActive == true
              && incoming().role == get(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower())).data.role
              && incoming().isActive == true
            )
          )
        )
      );
      allow update: if isValidId(userId) && isValidUserAccount(incoming()) && (
        isAdmin()
        || (
          isOwner(userId)
          && incoming().uid == existing().uid
          && incoming().email == existing().email
          && incoming().role == existing().role
          && incoming().isActive == existing().isActive
          && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'lastLoginAt', 'updatedAt'])
        )
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // =========================================================================
    // COMPANY SETTINGS & CONFIGURATION
    // =========================================================================
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && settingId in ['company', 'shipping_config'] && (isStaff() || isVerified());
      allow list: if isStaff();
      allow create, update: if isValidId(settingId) && settingId in ['company', 'shipping_config'] && (
        (settingId == 'company' && isAdmin() && isValidCompanySettings(incoming()))
        || (settingId == 'shipping_config' && isStaff() && isValidShippingConfig(incoming()))
      );
      allow delete: if isValidId(settingId) && isAdmin();
    }

    // =========================================================================
    // ERP BUSINESS COLLECTIONS
    // =========================================================================
    match /appointments/{appointmentId} {
      allow get: if isValidId(appointmentId) && (
        isStaff() || (isVerified() && existing().clientEmail.lower() == request.auth.token.email.lower())
      );
      allow list: if isStaff() || (isVerified() && resource.data.clientEmail == request.auth.token.email);
      allow create, update: if isValidId(appointmentId) && isStaff() && isValidAppointment(incoming());
      allow delete: if isValidId(appointmentId) && isAdmin();
    }

    match /volumeEstimations/{estimationId} {
      allow get: if isValidId(estimationId) && isStaff();
      allow list: if isStaff();
      allow create, update: if isValidId(estimationId) && isStaff() && isValidVolumeEstimation(incoming());
      allow delete: if isValidId(estimationId) && isAdmin();
    }

    match /quotes/{quoteId} {
      allow get: if isValidId(quoteId) && (
        isStaff() || (isVerified() && existing().clientEmail.lower() == request.auth.token.email.lower())
      );
      allow list: if isStaff() || (isVerified() && resource.data.clientEmail == request.auth.token.email);
      allow create: if isValidId(quoteId) && isStaff() && isValidQuote(incoming());
      allow update: if isValidId(quoteId) && isValidQuote(incoming()) && (
        isStaff()
        || (
          isVerified()
          && existing().clientEmail.lower() == request.auth.token.email.lower()
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedAt'])
          && incoming().status in ['accepte', 'refuse']
        )
      );
      allow delete: if isValidId(quoteId) && isAdmin();
    }

    match /chantiers/{chantierId} {
      allow get: if isValidId(chantierId) && (
        isStaff() || (isVerified() && ('clientEmail' in existing()) && existing().clientEmail.lower() == request.auth.token.email.lower())
      );
      allow list: if isStaff() || (isVerified() && resource.data.clientEmail == request.auth.token.email);
      allow create, update: if isValidId(chantierId) && isStaff() && isValidChantier(incoming());
      allow delete: if isValidId(chantierId) && isAdmin();
    }

    match /invoices/{invoiceId} {
      allow get: if isValidId(invoiceId) && (
        isStaff() || (isVerified() && existing().clientEmail.lower() == request.auth.token.email.lower())
      );
      allow list: if isStaff() || (isVerified() && resource.data.clientEmail == request.auth.token.email);
      allow create, update: if isValidId(invoiceId) && isStaff() && isValidInvoice(incoming());
      allow delete: if isValidId(invoiceId) && isAdmin();
    }

    match /expenses/{expenseId} {
      allow get, list: if isStaff();
      allow create, update: if isValidId(expenseId) && isStaff() && isValidExpense(incoming());
      allow delete: if isValidId(expenseId) && isAdmin();
    }

    match /transitShipments/{shipmentId} {
      allow get, list: if isStaff();
      allow create, update: if isValidId(shipmentId) && isStaff() && isValidTransitShipment(incoming());
      allow delete: if isValidId(shipmentId) && isAdmin();
    }

    match /shippingLines/{lineId} {
      allow get, list: if isStaff();
      allow create, update: if isValidId(lineId) && isStaff() && isValidShippingLine(incoming());
      allow delete: if isValidId(lineId) && isAdmin();
    }

    match /stockItems/{itemId} {
      allow get, list: if isStaff();
      allow create, update: if isValidId(itemId) && isStaff() && isValidStockItem(incoming());
      allow delete: if isValidId(itemId) && isAdmin();
    }

    match /stockMovements/{movementId} {
      allow get, list: if isStaff();
      allow create, update: if isValidId(movementId) && isStaff() && isValidStockMovement(incoming());
      allow delete: if isValidId(movementId) && isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow get, list: if isStaff();
      allow create, update: if isValidId(vehicleId) && isStaff() && isValidVehicle(incoming());
      allow delete: if isValidId(vehicleId) && isAdmin();
    }

    match /employees/{employeeId} {
      allow get, list: if isStaff();
      allow create, update: if isValidId(employeeId) && isAdmin() && isValidEmployee(incoming());
      allow delete: if isValidId(employeeId) && isAdmin();
    }

    match /emails/{emailId} {
      allow get, list: if isStaff();
      allow create, update: if isValidId(emailId) && isStaff() && isValidEmailMessage(incoming());
      allow delete: if isValidId(emailId) && isAdmin();
    }

    match /automationLogs/{logId} {
      allow get, list: if isStaff();
      allow create, update: if isValidId(logId) && isStaff() && isValidAutomationLog(incoming());
      allow delete: if isValidId(logId) && isAdmin();
    }
  }
}
